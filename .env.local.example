# Required for the Keystatic admin (/keystatic) to authenticate against GitHub
# in production (local dev uses local filesystem storage and needs none of this).
# Create a GitHub App — Keystatic walks you through this interactively the first
# time /keystatic is opened against the deployed site — then set these as real
# environment variables in Vercel (Project Settings → Environment Variables) —
# never commit the actual values.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
